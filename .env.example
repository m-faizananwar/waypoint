# Copy to .env for local runs. Every value here is a local development default.
PORT=3000
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint
REDIS_URL=redis://localhost:6379

# OIDC (Keycloak from docker-compose). Tokens are verified against the issuer's JWKS.
OIDC_ISSUER=http://localhost:8080/realms/waypoint
OIDC_AUDIENCE=waypoint-api
# Optional. Defaults to <OIDC_ISSUER>/protocol/openid-connect/certs
OIDC_JWKS_URI=

# Optional. Without a key the worker uses the built-in rules model, so the app runs offline.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Proposals below this confidence are flagged for a closer look by the approver.
TRIAGE_MIN_CONFIDENCE=0.6
